export function AppProvider({ children }) {
  const [chats, setChats] = useState(() => {
    try {
      const saved = localStorage.getItem('DEV_AI_CHATS_V4');
      return saved ? JSON.parse(saved) : [
        {
          id: 'chat_default',
          title: 'Oii...',
          createdAt: new Date().toISOString(),
          messages: [
            {
              role: 'assistant',
              content: 'Limite de Cota Atingido: A cota do modelo foi atingida temporariamente no plano gratuito. O sistema alterna modelos automaticamente; se persistir, aguarde um minuto antes de reenviar.',
              timestamp: new Date().toISOString()
            },
            {
              role: 'user',
              content: 'Oii',
              timestamp: new Date().toISOString()
            }
          ]
        }
      ];
    } catch {
      return [];
    }
  });

  const [trashedChats, setTrashedChats] = useState(() => {
    try {
      const saved = localStorage.getItem('DEV_AI_TRASH_V4');
      return saved ? JSON.parse(saved) : [];
    } catch {
      return [];
    }
  });

  const [activeChatId, setActiveChatId] = useState('chat_default');
  const [settings, setSettings] = useState(() => {
    try {
      const saved = localStorage.getItem('DEV_AI_SETTINGS_V4');
      return saved ? { ...DEFAULT_SETTINGS, ...JSON.parse(saved) } : DEFAULT_SETTINGS;
    } catch {
      return DEFAULT_SETTINGS;
    }
  });

  const [sidebarOpen, setSidebarOpen] = useState(false);
  const [settingsOpen, setSettingsOpen] = useState(false);
  const [shareModalOpen, setShareModalOpen] = useState(false);
  const [modelSelectorOpen, setModelSelectorOpen] = useState(false);
  const [expandedEditorOpen, setExpandedEditorOpen] = useState(false);
  const [renameModalData, setRenameModalData] = useState(null); // { id, title }
  const [editingMessageData, setEditingMessageData] = useState(null); // { text, index }

  const [isGenerating, setIsGenerating] = useState(false);
  const [generationTime, setGenerationTime] = useState(0);
  const [generationState, setGenerationState] = useState('');
  const [toastMessage, setToastMessage] = useState(null);
  const [previewHtmlCode, setPreviewHtmlCode] = useState(null);

  // Generation Timer
  useEffect(() => {
    let timer;
    if (isGenerating) {
      setGenerationTime(0);
      timer = setInterval(() => setGenerationTime(t => t + 1), 1000);
    } else {
      clearInterval(timer);
    }
    return () => clearInterval(timer);
  }, [isGenerating]);

  // Sync Storage
  useEffect(() => {
    try {
      localStorage.setItem('DEV_AI_CHATS_V4', JSON.stringify(chats));
    } catch (e) { console.error(e); }
  }, [chats]);

  useEffect(() => {
    try {
      localStorage.setItem('DEV_AI_TRASH_V4', JSON.stringify(trashedChats));
    } catch (e) { console.error(e); }
  }, [trashedChats]);

  useEffect(() => {
    try {
      localStorage.setItem('DEV_AI_SETTINGS_V4', JSON.stringify(settings));
    } catch (e) { console.error(e); }
  }, [settings]);

  // Apply Theme Classes
  useEffect(() => {
    const root = document.documentElement;
    root.classList.remove('dark', 'light', 'darker', 'dev-rgb');
    if (settings.theme === 'claro') {
      root.classList.add('light');
    } else if (settings.theme === 'darker') {
      root.classList.add('dark', 'darker');
    } else if (settings.theme === 'dev_rgb') {
      root.classList.add('dark', 'dev-rgb');
    } else {
      root.classList.add('dark');
    }
  }, [settings.theme]);

  const showToast = (text) => {
    setToastMessage(text);
    setTimeout(() => setToastMessage(null), 3000);
  };

  const createNewChat = () => {
    const newChat = {
      id: 'chat_' + Date.now(),
      title: 'Nova Conversa',
      createdAt: new Date().toISOString(),
      messages: []
    };
    setChats(prev => [newChat, ...prev]);
    setActiveChatId(newChat.id);
    return newChat.id;
  };

  const moveToTrash = (chatId) => {
    const chatToMove = chats.find(c => c.id === chatId);
    if (chatToMove) {
      setTrashedChats(prev => [{ ...chatToMove, deletedAt: new Date().toISOString() }, ...prev]);
      setChats(prev => prev.filter(c => c.id !== chatId));
      if (activeChatId === chatId) setActiveChatId(null);
      showToast('Conversa movida para a Lixeira');
    }
  };

  const restoreFromTrash = (chatId) => {
    const chatToRestore = trashedChats.find(c => c.id === chatId);
    if (chatToRestore) {
      setChats(prev => [chatToRestore, ...prev]);
      setTrashedChats(prev => prev.filter(c => c.id !== chatId));
      setActiveChatId(chatToRestore.id);
      showToast('Conversa restaurada!');
    }
  };

  const permanentlyDelete = (chatId) => {
    setTrashedChats(prev => prev.filter(c => c.id !== chatId));
    showToast('Excluído permanentemente');
  };

  const emptyTrash = () => {
    setTrashedChats([]);
    showToast('Lixeira esvaziada');
  };

  const renameChat = (chatId, newTitle) => {
    setChats(prev => prev.map(c => c.id === chatId ? { ...c, title: newTitle } : c));
    showToast('Conversa renomeada!');
  };

  const activeChat = useMemo(() => {
    return chats.find(c => c.id === activeChatId) || null;
  }, [chats, activeChatId]);

  return (
    <AppContext.Provider value={{
      chats, setChats, trashedChats, activeChatId, setActiveChatId, activeChat, createNewChat,
      moveToTrash, restoreFromTrash, permanentlyDelete, emptyTrash, renameChat, settings, setSettings,
      sidebarOpen, setSidebarOpen, settingsOpen, setSettingsOpen, shareModalOpen, setShareModalOpen,
      modelSelectorOpen, setModelSelectorOpen, expandedEditorOpen, setExpandedEditorOpen,
      renameModalData, setRenameModalData, editingMessageData, setEditingMessageData,
      isGenerating, setIsGenerating, generationTime, generationState, setGenerationState,
      showToast, toastMessage, previewHtmlCode, setPreviewHtmlCode
    }}>
      {children}
    </AppContext.Provider>
  );
}

const useApp = () => useContext(AppContext);

