function CodeBlock({ code, language }) {
  const { setPreviewHtmlCode, showToast, settings } = useApp();
  const [copied, setCopied] = useState(false);

  const meta = getLanguageMeta(language);
  const lines = useMemo(() => code.split('\n'), [code]);
  const lineCount = lines.length;

  const handleCopy = () => {
    navigator.clipboard.writeText(code);
    setCopied(true);
    showToast('Código copiado!');
    setTimeout(() => setCopied(false), 2000);
  };

  const handleDownload = () => {
    const blob = new Blob([code], { type: 'text/plain;charset=utf-8' });
    const url = URL.createObjectURL(blob);
    const a = document.createElement('a');
    a.href = url;
    a.download = `script_${Date.now()}${meta.ext}`;
    document.body.appendChild(a);
    a.click();
    document.body.removeChild(a);
    URL.revokeObjectURL(url);
    showToast(`Arquivo baixado como script_${Date.now()}${meta.ext}`);
  };

  const renderLineHighlight = (line) => {
    if (line.trim().startsWith('//') || line.trim().startsWith('#') || line.trim().startsWith('<!--')) {
      return <span className="text-neutral-500 italic">{line}</span>;
    }
    const parts = line.split(/(".*?"|'.*?'|`.*?`|\b(?:def|function|const|let|var|return|if|else|import|from|class|public|static|void|val|select|from|where)\b)/g);
    return parts.map((part, i) => {
      if (/^(".*?"|'.*?'|`.*?`)$/.test(part)) {
        return <span key={i} className="text-amber-300">{part}</span>;
      }
      if (/^(def|function|const|let|var|return|if|else|import|from|class|public|static|void|val|select|from|where)$/.test(part)) {
        return <span key={i} className="text-neutral-200 font-bold">{part}</span>;
      }
      return part;
    });
  };

  return (
    <div className="my-4 rounded-2xl border border-neutral-800 bg-neutral-950 text-neutral-100 overflow-hidden shadow-2xl font-mono text-xs md:text-sm">
      <div className="flex items-center justify-between px-4 py-2.5 bg-neutral-900/90 border-b border-neutral-800/80 text-neutral-300">
        <div className="flex items-center gap-2.5">
          <div className="flex items-center justify-center p-1 bg-neutral-950 rounded-lg border border-neutral-800 shadow-xs">
            {meta.logo}
          </div>
          <span className="font-semibold tracking-wide text-xs text-neutral-200">{meta.name}</span>
          <span className="text-neutral-500 text-[11px]">· {lineCount} {lineCount === 1 ? 'linha' : 'linhas'}</span>
        </div>

        <div className="flex items-center gap-1.5">
          {meta.isHtml && (
            <button
              onClick={() => setPreviewHtmlCode(code)}
              className="flex items-center gap-1.5 px-2.5 py-1 bg-emerald-600 hover:bg-emerald-500 text-white rounded-lg text-xs font-semibold transition-all shadow-xs"
              title="Executar preview do HTML"
            >
              <Play className="w-3.5 h-3.5 fill-current" />
              <span>Play</span>
            </button>
          )}

          <button
            onClick={handleDownload}
            className="flex items-center gap-1 px-2.5 py-1 text-neutral-400 hover:text-neutral-100 hover:bg-neutral-800 rounded-lg transition-colors"
            title="Baixar código"
          >
            <Download className="w-3.5 h-3.5" />
            <span className="hidden sm:inline text-xs">Download</span>
          </button>

          <button
            onClick={handleCopy}
            className="flex items-center gap-1 px-2.5 py-1 text-neutral-400 hover:text-neutral-100 hover:bg-neutral-800 rounded-lg transition-colors"
            title="Copiar código"
          >
