class SimulatedAIProvider extends BaseAIProvider {
  constructor() {
    super();
    this.isCancelling = false;
  }

  async cancelGeneration() {
    this.isCancelling = true;
  }

  async streamResponse(messages, onChunk, onStateChange, options = {}) {
    this.isCancelling = false;
    const lastUserMessage = messages[messages.length - 1]?.content || '';
    const lower = lastUserMessage.toLowerCase();

    if (onStateChange) onStateChange('Conectando...');
    await new Promise(r => setTimeout(r, 400));

    if (onStateChange) onStateChange('Analisando solicitação...');
    await new Promise(r => setTimeout(r, 600));

    let simulatedText = '';

    if (lower.includes('html') || lower.includes('landing') || lower.includes('site')) {
      if (onStateChange) onStateChange('Preparando código...');
      simulatedText = `Aqui está um exemplo de código HTML responsivo completo com estilização CSS embutida. Clique no botão **Play** no topo do bloco para visualizar em tempo real!\n\n\`\`\`html\n<!DOCTYPE html>\n<html lang="pt-BR">\n<head>\n  <meta charset="UTF-8">\n  <title>Dev AI - Web Preview</title>\n  <style>\n    body {\n      font-family: system-ui, sans-serif;\n      background: #09090b;\n      color: #f4f4f5;\n      display: flex;\n      flex-direction: column;\n      align-items: center;\n      justify-content: center;\n      height: 100vh;\n      margin: 0;\n    }\n    .card {\n      background: rgba(255, 255, 255, 0.05);\n      backdrop-filter: blur(10px);\n      border: 1px solid rgba(255, 255, 255, 0.1);\n      padding: 2.5rem;\n      border-radius: 1.5rem;\n      text-align: center;\n      box-shadow: 0 10px 30px rgba(0,0,0,0.5);\n    }\n    button {\n      background: #2563eb;\n      color: white;\n      border: none;\n      padding: 0.75rem 1.5rem;\n      border-radius: 0.75rem;\n      font-weight: 600;\n      cursor: pointer;\n      margin-top: 1.25rem;\n      transition: all 0.2s;\n    }\n    button:hover { background: #1d4ed8; transform: translateY(-2px); }\n  </style>\n</head>\n<body>\n  <div class="card">\n    <h1>DEV AI Interactive Sandbox</h1>\n    <p>O código foi isolado com segurança para execução instantânea!</p>\n    <button onclick="alert('Componente executado perfeitamente!')">Testar Evento</button>\n  </div>\n</body>\n</html>\n\`\`\n\nEste código demonstra nossa sandbox de renderização HTML.`;
    } else if (lower.includes('código') || lower.includes('code') || lower.includes('python')) {
