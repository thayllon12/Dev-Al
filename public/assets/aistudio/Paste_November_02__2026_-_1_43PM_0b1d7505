const getLanguageMeta = (lang) => {
  const l = (lang || '').toLowerCase().trim();
  if (l === 'js' || l === 'javascript') return { name: 'JavaScript', ext: '.js', logo: LanguageLogos.javascript };
  if (l === 'ts' || l === 'typescript') return { name: 'TypeScript', ext: '.ts', logo: LanguageLogos.typescript };
  if (l === 'py' || l === 'python') return { name: 'Python', ext: '.py', logo: LanguageLogos.python };
  if (l === 'html' || l === 'html5') return { name: 'HTML', ext: '.html', logo: LanguageLogos.html, isHtml: true };
  if (l === 'css' || l === 'css3') return { name: 'CSS', ext: '.css', logo: LanguageLogos.css };
  if (l === 'lua') return { name: 'Lua', ext: '.lua', logo: LanguageLogos.lua };
  if (l === 'luau') return { name: 'Luau', ext: '.luau', logo: LanguageLogos.lua };
  if (l === 'java') return { name: 'Java', ext: '.java', logo: LanguageLogos.java };
  if (l === 'cpp' || l === 'c++') return { name: 'C++', ext: '.cpp', logo: LanguageLogos.cpp };
  if (l === 'json') return { name: 'JSON', ext: '.json', logo: LanguageLogos.json };
  return { name: lang.toUpperCase() || 'Code', ext: '.txt', logo: <Code className="w-4 h-4 text-neutral-400" /> };
};

