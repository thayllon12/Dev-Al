function ChatView({ messages, isGenerating, onSendMessage, onRegenerate, onEditUserMessage }) {
  const messagesEndRef = useRef(null);
  const { settings, showToast, generationTime, generationState } = useApp();
  const [activeMenuIndex, setActiveMenuIndex] = useState(null);
  const [speakingIndex, setSpeakingIndex] = useState(null);

  useEffect(() => {
    messagesEndRef.current?.scrollIntoView({ behavior: 'smooth' });
  }, [messages, isGenerating]);

  const handleTTS = (index, text) => {
    if (!('speechSynthesis' in window)) {
      showToast('Síntese de voz não suportada');
      return;
    }
    if (speakingIndex === index) {
      window.speechSynthesis.cancel();
      setSpeakingIndex(null);
      return;
    }
    window.speechSynthesis.cancel();
    const utterance = new SpeechSynthesisUtterance(text);
    utterance.lang = 'pt-BR';
    utterance.onend = () => setSpeakingIndex(null);
    utterance.onerror = () => setSpeakingIndex(null);
    window.speechSynthesis.speak(utterance);
    setSpeakingIndex(index);
  };

  const handleCopy = (text) => {
    navigator.clipboard.writeText(text);
    showToast('Texto copiado!');
  };

  const handleDownloadResponse = (content) => {
    const blob = new Blob([content], { type: 'text/markdown;charset=utf-8' });
    const url = URL.createObjectURL(blob);
    const a = document.createElement('a');
    a.href = url;
    a.download = `resposta_dev_ai_${Date.now()}.md`;
    a.click();
    URL.revokeObjectURL(url);
    showToast('Resposta baixada');
  };

  const formatTimer = (secs) => {
    const m = String(Math.floor(secs / 60)).padStart(2, '0');
    const s = String(secs % 60).padStart(2, '0');
    return `${m}:${s}`;
